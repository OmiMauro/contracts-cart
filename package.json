{
  "name": "@cart/contracts",
  "version": "0.3.0",
  "description": "Enums, constants and types of the API contract, shared by rest-api and web-app.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
